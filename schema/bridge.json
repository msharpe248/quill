{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quill shell-core bridge",
  "description": "Messages between the Swift app shell and the Rust core. JSON-RPC 2.0 notifications, one JSON object per line, over a Unix domain socket whose path the shell passes to the core in QUILL_SHELL_SOCKET. The shell listens; the core connects. The shell knows command names, never mail semantics. Every message here has an example under schema/examples that both sides test against; change all three together.",
  "oneOf": [
    { "$ref": "#/$defs/coreToShell" },
    { "$ref": "#/$defs/shellToCore" }
  ],
  "$defs": {
    "coreToShell": {
      "oneOf": [
        { "$ref": "#/$defs/commands.list" },
        { "$ref": "#/$defs/state.update" },
        { "$ref": "#/$defs/pane.preview" },
        { "$ref": "#/$defs/pane.close" },
        { "$ref": "#/$defs/link.open" },
        { "$ref": "#/$defs/files.pick" },
        { "$ref": "#/$defs/clipboard.write" },
        { "$ref": "#/$defs/pane.play" },
        { "$ref": "#/$defs/pane.web" },
        { "$ref": "#/$defs/thumbnail.make" },
        { "$ref": "#/$defs/file.open" },
        { "$ref": "#/$defs/files.save" },
        { "$ref": "#/$defs/notify.post" },
        { "$ref": "#/$defs/notify.clear" },
        { "$ref": "#/$defs/spell.check" },
        { "$ref": "#/$defs/spell.suggest" },
        { "$ref": "#/$defs/pane.editor" }
      ]
    },
    "shellToCore": {
      "oneOf": [
        { "$ref": "#/$defs/command.run" },
        { "$ref": "#/$defs/files.dropped" },
        { "$ref": "#/$defs/thumbnail.made" },
        { "$ref": "#/$defs/files.saved" },
        { "$ref": "#/$defs/notify.used" },
        { "$ref": "#/$defs/url.open" },
        { "$ref": "#/$defs/spell.checked" },
        { "$ref": "#/$defs/spell.suggested" },
        { "$ref": "#/$defs/editor.exited" },
        { "$ref": "#/$defs/app.will_quit" }
      ]
    },

    "commands.list": {
      "description": "Core to shell, once at startup. Every command, in the order menus should list them.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "commands.list" },
        "params": {
          "type": "object",
          "required": ["commands"],
          "additionalProperties": false,
          "properties": {
            "commands": {
              "type": "array",
              "items": { "$ref": "#/$defs/command" }
            }
          }
        }
      }
    },
    "command": {
      "type": "object",
      "required": ["name", "title", "keys"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "The stable name, as used in keys.toml and command.run.",
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z_]+)+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "keys": {
          "description": "Key sequences bound to the command, preferred first, in Quill's notation: \"j\", \"g g\", \"ctrl-k\", \"cmd-enter\".",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "menu": {
          "description": "The menu the command appears in. Absent for plain cursor movement, which has no menu item.",
          "enum": ["app", "file", "edit", "view", "mailbox", "message", "window", "help"]
        },
        "symbol": {
          "description": "An SF Symbol name. A command with one may be shown in the toolbar.",
          "type": "string",
          "minLength": 1
        }
      }
    },

    "state.update": {
      "description": "Core to shell, whenever any of it changes. Always the whole state, never a delta.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "state.update" },
        "params": {
          "type": "object",
          "required": ["context", "enabled", "unread", "title"],
          "additionalProperties": false,
          "properties": {
            "context": {
              "description": "Where the keyboard focus is inside the terminal UI.",
              "enum": ["sidebar", "list", "reader", "help", "links", "setup", "certificate", "folders", "compose", "palette", "search"]
            },
            "enabled": {
              "description": "Names of the commands that would do something right now. Menu items and toolbar buttons for every other command are disabled.",
              "type": "array",
              "items": { "type": "string" }
            },
            "unread": {
              "description": "Unread messages across all inboxes, for the Dock badge.",
              "type": "integer",
              "minimum": 0
            },
            "title": {
              "description": "The window title.",
              "type": "string"
            }
          }
        }
      }
    },

    "pane.preview": {
      "description": "Core to shell. Show files in a Quick Look pane beside the terminal: one at a time, starting with the one at `index`. The user steps through the rest with the arrow keys while the pane has the focus.",
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "pane.preview"
        },
        "params": {
          "type": "object",
          "required": [
            "items",
            "index"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "title"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "description": "Absolute path of a file the shell can read.",
                    "type": "string",
                    "pattern": "^/"
                  },
                  "title": {
                    "type": "string"
                  }
                }
              }
            },
            "index": {
              "description": "Which of the items to show first, from 0. Less than the number of items.",
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },

    "pane.play": {
      "description": "Core to shell. Play a video or audio file in a player pane beside the terminal.",
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "pane.play"
        },
        "params": {
          "type": "object",
          "required": [
            "path",
            "title"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "description": "Absolute path of a file the shell can read.",
              "type": "string",
              "pattern": "^/"
            },
            "title": {
              "type": "string"
            }
          }
        }
      }
    },

    "pane.web": {
      "description": "Core to shell. Show an HTML file the core has already sanitized in a web view pane beside the terminal. Scripts never run. Nothing is loaded over the network unless `remote` is true; links open in the user's browser, never in the pane.",
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "pane.web"
        },
        "params": {
          "type": "object",
          "required": [
            "path",
            "title",
            "remote"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "description": "Absolute path of the HTML file. Files beside it in the same folder may be loaded by it.",
              "type": "string",
              "pattern": "^/"
            },
            "title": {
              "type": "string"
            },
            "remote": {
              "description": "The user has allowed this message to load remote content.",
              "type": "boolean"
            }
          }
        }
      }
    },

    "thumbnail.make": {
      "description": "Core to shell. Make a PNG thumbnail of a file (a picture the core cannot decode, the first page of a PDF, the poster frame of a video) and write it to `out`. Answered by thumbnail.made with the same id.",
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "thumbnail.make"
        },
        "params": {
          "type": "object",
          "required": [
            "id",
            "path",
            "out",
            "size"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "path": {
              "description": "Absolute path of the file to picture.",
              "type": "string",
              "pattern": "^/"
            },
            "out": {
              "description": "Absolute path to write the PNG to.",
              "type": "string",
              "pattern": "^/"
            },
            "size": {
              "description": "The longest side wanted, in pixels.",
              "type": "integer",
              "minimum": 16,
              "maximum": 4096
            }
          }
        }
      }
    },

    "file.open": {
      "description": "Core to shell. Open a file in the application the user's Mac opens its kind with. Only ever on an explicit key press by the user.",
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "file.open"
        },
        "params": {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "description": "Absolute path of a file the shell can read.",
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      }
    },

    "files.save": {
      "description": "Core to shell. Ask the user where to save a copy of a file, with the native save panel, and save it there. Answered by files.saved.",
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "files.save"
        },
        "params": {
          "type": "object",
          "required": [
            "path",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "description": "Absolute path of the file to copy.",
              "type": "string",
              "pattern": "^/"
            },
            "name": {
              "description": "The name to offer in the panel.",
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },

    "link.open": {
      "description": "Core to shell. Open a web or mail address in the user's default browser or mail program. The shell opens nothing else: no other scheme, and nothing outside printable ASCII.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "link.open" },
        "params": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": {
              "description": "An http, https or mailto address.",
              "type": "string",
              "pattern": "^([hH][tT][tT][pP][sS]?://|[mM][aA][iI][lL][tT][oO]:)[!-~]+$"
            }
          }
        }
      }
    },

    "pane.close": {
      "description": "Core to shell. Close the second pane and return focus to the terminal.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "pane.close" },
        "params": { "type": "object", "additionalProperties": false }
      }
    },

    "files.pick": {
      "description": "Core to shell. Ask the user to choose files with the native open panel. What they choose arrives as files.dropped; cancelling sends nothing.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "files.pick" },
        "params": { "type": "object", "additionalProperties": false }
      }
    },

    "clipboard.write": {
      "description": "Core to shell. Put text on the system clipboard: the user copied or cut it in the terminal UI.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "clipboard.write" },
        "params": {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string" }
          }
        }
      }
    },

    "files.dropped": {
      "description": "Shell to core. The user chose files in the open panel or dropped them onto the window. The shell does not know what they are for; the core decides.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "files.dropped" },
        "params": {
          "type": "object",
          "required": ["paths", "temporary"],
          "additionalProperties": false,
          "properties": {
            "paths": {
              "description": "Absolute paths of files the core can read.",
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^/" }
            },
            "temporary": {
              "description": "The files are copies the shell made for the core, which removes each once it has read it. False: they are the user's own files and are left alone.",
              "type": "boolean"
            }
          }
        }
      }
    },

    "command.run": {
      "description": "Shell to core. A menu item or toolbar button was used.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "command.run" },
        "params": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "thumbnail.made": {
      "description": "Shell to core. The answer to thumbnail.make: the PNG was written to the path asked for, or could not be made.",
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "thumbnail.made"
        },
        "params": {
          "type": "object",
          "required": [
            "id",
            "ok"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "ok": {
              "type": "boolean"
            }
          }
        }
      }
    },

    "files.saved": {
      "description": "Shell to core. The answer to files.save: the copy was saved, or the user cancelled or it could not be written.",
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "files.saved"
        },
        "params": {
          "type": "object",
          "required": [
            "name",
            "saved"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "description": "The name the file was saved under, or was offered under if it was not saved.",
              "type": "string"
            },
            "saved": {
              "type": "boolean"
            }
          }
        }
      }
    },

    "notify.post": {
      "description": "Core to shell. Show a notification, in place of any earlier one with the same id. The shell shows the words as plain text and returns the id, and an action's name, in notify.used. It knows nothing else about them.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "notify.post" },
        "params": {
          "type": "object",
          "required": ["id", "title", "body", "actions"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "description": "The core's name for the notification.",
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "title": { "type": "string", "minLength": 1 },
            "subtitle": { "type": "string" },
            "body": { "type": "string" },
            "actions": {
              "description": "Buttons on the notification, in order. None is allowed.",
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["name", "title"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "title": { "type": "string", "minLength": 1 },
                  "foreground": {
                    "description": "Using this action brings Quill's window forward: what it starts needs the user there, as a reply does. Left out, the action is done in the background.",
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },

    "notify.clear": {
      "description": "Core to shell. Take down the notifications with these ids, shown or waiting. One that is not there is not an error.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "notify.clear" },
        "params": {
          "type": "object",
          "required": ["ids"],
          "additionalProperties": false,
          "properties": {
            "ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        }
      }
    },

    "notify.used": {
      "description": "Shell to core. The user clicked a notification, or one of its actions.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "notify.used" },
        "params": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "action": {
              "description": "The name of the action chosen. Left out when the notification itself was clicked.",
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    },

    "url.open": {
      "description": "Shell to core. The Mac asked Quill to open a mail address: a mailto link clicked in another application. Only mailto addresses are passed on.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "url.open" },
        "params": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^mailto:",
              "maxLength": 8192
            }
          }
        }
      }
    },

    "spell.check": {
      "description": "Core to shell. Check the spelling of some text with the system's checker, in the user's languages. Answered by spell.checked with the same id. Nothing is learned or remembered from the text.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "spell.check" },
        "params": {
          "type": "object",
          "required": ["id", "text"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "integer", "minimum": 0 },
            "text": { "type": "string", "maxLength": 100000 }
          }
        }
      }
    },

    "spell.checked": {
      "description": "Shell to core. The answer to spell.check: where the misspelt words are, each as the byte offsets of its start and end in the text as UTF-8, in order and not overlapping.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "spell.checked" },
        "params": {
          "type": "object",
          "required": ["id", "words"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "integer", "minimum": 0 },
            "words": {
              "type": "array",
              "maxItems": 2000,
              "items": {
                "type": "object",
                "required": ["start", "end"],
                "additionalProperties": false,
                "properties": {
                  "start": { "type": "integer", "minimum": 0 },
                  "end": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    },

    "spell.suggest": {
      "description": "Core to shell. Ask the system's checker what a misspelt word might have been meant to be. Answered by spell.suggested with the same id.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "spell.suggest" },
        "params": {
          "type": "object",
          "required": ["id", "word"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "integer", "minimum": 0 },
            "word": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    },

    "spell.suggested": {
      "description": "Shell to core. The answer to spell.suggest: words to offer, the likeliest first. None is an answer too.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "spell.suggested" },
        "params": {
          "type": "object",
          "required": ["id", "words"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "integer", "minimum": 0 },
            "words": {
              "type": "array",
              "maxItems": 20,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        }
      }
    },

    "pane.editor": {
      "description": "Core to shell. Run Vim on a draft file, in a terminal pane of its own. `vim` says which: `system` is the one that comes with macOS (/usr/bin/vim), run inside the sandbox; `script` the user's own, by way of the script they keep in the app's scripts folder (editor-command.sh), which macOS runs outside the sandbox and which the user has to have asked for in their config. The app has no Vim of its own inside it. The core never names a program by its path. `dir` is the draft's own folder, where Vim and the core leave each other notes; the shell passes it to Vim in the environment and does nothing else with it. Answered by editor.exited when Vim ends, or at once if it could not be started.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "pane.editor" },
        "params": {
          "type": "object",
          "required": ["path", "dir", "title", "vim"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "dir": { "type": "string", "pattern": "^/" },
            "title": { "type": "string" },
            "vim": { "enum": ["system", "script"] }
          }
        }
      }
    },

    "editor.exited": {
      "description": "Shell to core. The answer to pane.editor. `ran` is false when Vim could not be started (the one asked for is not there); `status` is then 0. Otherwise `status` is what Vim exited with: 0 for a normal exit, anything else for :cq or a crash.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "editor.exited" },
        "params": {
          "type": "object",
          "required": ["ran", "status"],
          "additionalProperties": false,
          "properties": {
            "ran": { "type": "boolean" },
            "status": { "type": "integer", "minimum": -255, "maximum": 255 }
          }
        }
      }
    },

    "app.will_quit": {
      "description": "Shell to core. The app is quitting: flush and exit cleanly.",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "app.will_quit" },
        "params": { "type": "object", "additionalProperties": false }
      }
    }
  }
}
